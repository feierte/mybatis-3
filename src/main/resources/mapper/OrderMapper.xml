<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.apache.ibatis.demo.mapper.OrderMapper">

    <!-- 配置方式二： 使用association -->
    <resultMap id="orderMap" type="org.apache.ibatis.demo.domain.Order">
        <result property="id" column="id"></result>
        <result property="orderTime" column="order_time"></result>
        <result property="total" column="total"></result>

        <association property="user" javaType="org.apache.ibatis.demo.domain.User">
            <result property="id" column="uid"></result>
            <result property="username" column="username"></result>
        </association>
    </resultMap>

    <select id="findOrderAndUser" resultMap="orderMap">
        select * from orders o,user u where o.uid=u.id
    </select>


