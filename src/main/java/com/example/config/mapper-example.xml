<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mapper.UserMapper">

    <!--
        二级缓存开关，需要和 setting 属性 cacheEnabled 一起配合使用。
        readOnly：默认值 false，每次 get 返回反序列化的新对象，实体类必须实现 Serializable 接口，有性能开销，线程安全；
                true 每次 get 返回缓存中的同一个对象引用，性能高，线程不安全（多线程下可能被意外修改，导致脏数据）；
                仅当确定结果对象 不会被修改 时，才可设为 readOnly=true。
        eviction：缓存回收策略。
            LRU（默认）：最近最少使用，移除最长时间不被使用的对象。
            FIFO：先进先出，按对象进入缓存的顺序来移除它们。
            SOFT：软引用，基于垃圾回收器状态和软引用规则移除对象。
            WEAK：弱引用，更积极地基于垃圾收集器状态移除对象。
        flushInterval：缓存刷新间隔（毫秒）。默认不清空，设置后到时间会清空整个缓存。
        size：缓存存放多少元素。
    -->
    <cache readOnly="false" blocking="" eviction="" flushInterval="" size="" type=""/>


    <resultMap id="parentResultMap" type="com.example.model.User"/>

    <resultMap id="myResultMap" type="com.example.model.User" autoMapping="false" extends="parentResultMap">

    </resultMap>

    <!--
        id：唯一标识。
        parameterType：传入参数的完整类名或别名（可选，MyBatis 能够自动推断）。
        resultType：返回结果的类型（简单类型或 POJO），不能与 resultMap 同时使用。
        resultMap：引用 <resultMap> 的 id，用于复杂结果映射，不能与 resultType 同时使用。
            如果 resultType 和 resultMap 都没设置，则使用自动映射（auto-mapping）。
        flushCache：是否在调用前清空本地缓存和二级缓存。默认值 false，表示查询不刷新缓存。
        useCache：是否使用二级缓存。默认 true，使用二级缓存。
        timeout：查询超时时间（秒）。默认无，使用的是全局配置。
        fetchSize：jdbc 驱动每次从数据库获取的记录数（用于性能调优）。
        statementType：使用哪种 Statement 类型。默认使用 PREPARED。
        databaseId：用于多数据库支持，匹配当前 databaseId。
        resultOrdered：仅用于嵌套结果映射，表示结果是否已排序（优化嵌套映射）。默认 false
        resultSets：用于多个结果集（存储过程返回多个 ResultSet）。
     -->
    <select id="selectDemo" databaseId="" fetchSize="" flushCache="" lang="" parameterType="" resultOrdered="" resultMap="" resultSets=""
            resultSetType="DEFAULT" resultType="Account" statementType="PREPARED" timeout="" useCache=""/>
</mapper>